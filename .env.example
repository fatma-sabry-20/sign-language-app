# انسخ الملف ده باسم .env (أو حط المتغيرات في إعدادات الاستضافة) - كله اختياري

# بورت السيرفر
PORT=3000

# على الاستضافة الحقيقية (https) خلّيها production
# NODE_ENV=production

# --- إرسال SMS حقيقي عن طريق Twilio (اختياري) ---
# من حسابك على twilio.com
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
# TWILIO_FROM=+1xxxxxxxxxx
